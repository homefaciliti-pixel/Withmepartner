# Server Configuration
PORT=5000
BASE_URL=https://withmepartner.onrender.com

# MySQL Database Configuration (Supports both DB_* and MYSQL_* variable prefixes)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=your_db_name

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# DLT SMS Gateway Configuration (SMSGATEWAYHUB)
SMSProvider=SMSGATEWAYHUB
SMS_ENTITY_ID=1201173444411453897
SMS_DLT_TEMPLATE_ID=1207173589889308632
SMS_SENDER_ID=HMFCLI
SMS_TEMPLATE_TEXT="Your OTP for registering on Superhome is: {#var#}. This code is valid for the next 10 minutes. Thank You, Super Home"
SMS_API_KEY=your_sms_api_key

# Cross-App User App Sync API Endpoint
USER_APP_API_URL=https://withmeapi-userapp.onrender.com
